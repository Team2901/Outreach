<?xml version="1.0" encoding="UTF-8"?>

<!--Markup file for the ClawBot robot graphics-->

<?import javafx.scene.Group?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>

<Group xmlns="http://javafx.com/javafx"
       xmlns:fx="http://javafx.com/fxml" fx:controller="virtual_robot.robots.classes.ClawBot">
    <children>

        <!--Chassis: 75x75-->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="YELLOW" height="75.0" stroke="BLACK" strokeType="INSIDE" width="75.0" />

        <!--Left drive wheel-->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BLUE" height="20.0" stroke="BLACK" strokeType="INSIDE" width="10.0" y="27.0" />

        <!--Right drive wheel-->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BLUE" height="20.0" stroke="BLACK" strokeType="INSIDE" width="10.0" x="65.0" y="27.0" />

        <!--Green square indicating the front center of the robot-->
        <Rectangle arcHeight="5.0" fill="LIME" height="10.0" stroke="BLACK" strokeType="INSIDE" width="10.0" x="32.5" />

        <!--The color sensor-->
        <Circle centerX="37.0" centerY="37.0" radius="10.0" strokeType="INSIDE" strokeWidth="0.0">
            <fill>
                <RadialGradient centerX="0.4722222222222222" centerY="0.4666666666666667" radius="0.6046511627906976">
                    <stops>
                        <Stop color="#3900ff" />
                        <Stop color="#ff00b6" offset="0.15649563534383953" />
                        <Stop color="#ff1100" offset="0.32195757791207485" />
                        <Stop color="#ffee00" offset="0.4880910060433701" />
                        <Stop color="#18ff00" offset="0.675751471343366" />
                        <Stop color="#00fffc" offset="0.8281391950073069" />
                        <Stop color="WHITE" offset="1.0" />
                    </stops>
                </RadialGradient>
            </fill>
        </Circle>

        <!--Arm + claw. ClawBot rotates this whole group about the robot center (37.5, 37.5)
            in proportion to the arm motor's encoder position.-->
        <Group fx:id="armGroup">
            <children>
                <!--Arm rod, extending toward the back of the robot-->
                <Rectangle arcHeight="3.0" arcWidth="3.0" fill="SILVER" height="28.0" stroke="BLACK" strokeType="INSIDE" width="4.0" x="35.5" y="37.0" />
                <!--Claw crossbar at the end of the arm-->
                <Rectangle arcHeight="3.0" arcWidth="3.0" fill="SILVER" height="4.0" stroke="BLACK" strokeType="INSIDE" width="21.0" x="27.0" y="63.0" />
                <!--Claw fingers: ClawBot translates these along X to open / close the claw-->
                <Rectangle fx:id="leftClaw" arcHeight="3.0" arcWidth="3.0" fill="DIMGRAY" height="9.0" stroke="BLACK" strokeType="INSIDE" width="4.0" x="29.0" y="65.0" />
                <Rectangle fx:id="rightClaw" arcHeight="3.0" arcWidth="3.0" fill="DIMGRAY" height="9.0" stroke="BLACK" strokeType="INSIDE" width="4.0" x="42.0" y="65.0" />
            </children>
        </Group>

    </children>
</Group>
